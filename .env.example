# Copiar a .env y reemplazar cada valor. Solo letras y numeros, minimo 8
# caracteres; evitar @ / " $ ! que rompen bash o sqlplus.
ORACLE_PASSWORD=cambiar
PROPIETARIO_PASSWORD=cambiar
SVC_GERENCIA_PASSWORD=cambiar
SVC_CENTRO_PASSWORD=cambiar
SVC_MESA_PASSWORD=cambiar
SVC_MENSAJERO_PASSWORD=cambiar
SVC_CLIENTE_PASSWORD=cambiar

# Contrasena de los cinco usuarios de demostracion (demo/start.sh).
# Minimo 8 caracteres, con al menos una letra y un numero; solo letras y numeros.
DEMO_PASSWORD=cambiar

